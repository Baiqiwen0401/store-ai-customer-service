# Copy these values into your shell session; never commit real secrets.
STORE_AI_ENV=development
STORE_AI_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
STORE_AI_MAX_BODY_BYTES=262144
STORE_AI_LOG_LEVEL=INFO
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://new.tianluo.ccwu.cc/v1
LLM_MODEL=gpt-5.6-sol
LLM_TIMEOUT_SECONDS=8
# Optional production AI orchestration. When configured, complex questions use
# the Dify Workflow API; direct knowledge answers remain in the business backend.
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_USER=store-ai
DIFY_TIMEOUT_SECONDS=8
STAFF_ACCESS_KEY=
STORE_AI_HOST=127.0.0.1
STORE_AI_PORT=8000
STORE_AI_DB_PATH=./runtime/store-ai.sqlite3
